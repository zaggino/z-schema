{
  "name": "z-schema",
  "version": "7.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "JSON schema validator",
  "homepage": "https://github.com/zaggino/z-schema",
  "authors": [
    "Martin Zagora <zaggino@gmail.com>"
  ],
  "license": "MIT",
  "keywords": [
    "JSON",
    "Schema",
    "Validator"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zaggino/z-schema.git"
  },
  "bugs": {
    "url": "https://github.com/zaggino/z-schema/issues"
  },
  "type": "module",
  "main": "src/ZSchema.js",
  "bin": {
    "z-schema": "./bin/z-schema"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "index.d.ts",
    "LICENSE",
    "README.md"
  ],
  "types": "index.d.ts",
  "scripts": {
    "prepare": "npm run build",
    "build": "rollup -c",
    "build:browser": "rollup -c --environment BROWSER",
    "build:watch": "rollup -c -w",
    "prepublishOnly": "npm test",
    "test": "vitest run",
    "test:browsers": "vitest run --project browsers --silent=true",
    "test:node": "vitest run --project node --silent=true",
    "test:sample": "npx vitest run --silent=false --hideSkippedTests --project node -t \"invalid definition\""
  },
  "testling": {
    "scripts": [
      "test/Runner.js",
      "dist/ZSchema-browser-min.js",
      "dist/ZSchema-browser-test.js"
    ],
    "browsers": [
      "iexplore/9..latest",
      "chrome/4",
      "chrome/28..latest",
      "firefox/3.5",
      "firefox/23..latest",
      "safari/5.1..latest",
      "opera/12..latest",
      "iphone/6..latest",
      "ipad/6..latest",
      "android-browser/4.2..latest"
    ]
  },
  "dependencies": {
    "lodash.get": "^4.4.2",
    "lodash.isequal": "^4.5.0",
    "validator": "^13.7.0"
  },
  "optionalDependencies": {
    "commander": "^14.0.2"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@vitest/browser-playwright": "^4.0.18",
    "browserify": "^17.0.0",
    "coveralls": "^3.1.1",
    "grunt-browserify": "^6.0.0",
    "grunt-cli": "^1.4.3",
    "grunt-contrib-copy": "^1.0.0",
    "grunt-contrib-jshint": "^3.2.0",
    "grunt-contrib-uglify": "^5.2.2",
    "grunt-jscs": "^3.0.1",
    "grunt-lineending": "^1.0.0",
    "jsdom": "^27.4.0",
    "remapify": "^2.2.0",
    "rollup": "^4.57.0",
    "vitest": "^4.0.18"
  }
}
