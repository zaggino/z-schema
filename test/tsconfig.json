{
  "extends": "../tsconfig",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node"],
    "typeRoots": ["../node_modules", "../node_modules/@types", "../node_modules/@types/node"],
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "NodeNext",
    "module": "NodeNext",
    "target": "ES2020"
  },
  "include": ["./**/*"]
}
