{
  "name": "z-schema",
  "version": "8.5.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "description": "JSON schema validator",
  "homepage": "https://github.com/zaggino/z-schema",
  "authors": [
    "Martin Zagora <zaggino@gmail.com>"
  ],
  "license": "MIT",
  "keywords": [
    "JSON",
    "Schema",
    "Validator"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zaggino/z-schema.git"
  },
  "bugs": {
    "url": "https://github.com/zaggino/z-schema/issues"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./cjs/index.d.ts",
        "default": "./cjs/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "z-schema": "bin/z-schema"
  },
  "files": [
    "bin/",
    "cjs/",
    "dist/",
    "src/",
    "umd/",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "prepare": "husky",
    "pre-commit": "npx lint-staged",
    "pre-push": "npm run build && npm run build:tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --fix",
    "lint:check": "eslint",
    "clean": "rimraf ./cjs && rimraf ./dist && rimraf ./umd && rimraf --glob \"./src/schemas/*.json\"",
    "build": "npm run copy:schemas && tsc && npm run copy:module-json && rollup -c",
    "build:browser": "rollup -c --environment BROWSER",
    "build:watch": "rollup -c -w",
    "build:tests": "tsc --noEmit --project test/tsconfig.json",
    "copy:module-json": "node -e \"fs.copyFileSync('./src/package.json', './dist/package.json')\"",
    "copy:schemas": "node ./scripts/copy-schemas.mts",
    "prepublishOnly": "npm run clean && npm run build && npm test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:node": "vitest run --project node --silent=false",
    "test:browser": "vitest run --project browser --silent=false",
    "test:sample": "npx vitest run --silent=false --hideSkippedTests --project node -t \"invalid definition\""
  },
  "dependencies": {
    "lodash.isequal": "^4.5.0",
    "validator": "^13.15.26"
  },
  "optionalDependencies": {
    "commander": "^14.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/json": "^1.0.0",
    "@eslint/markdown": "^7.5.1",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^25.2.0",
    "@types/validator": "^13.15.10",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-istanbul": "^4.0.18",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/eslint-plugin": "^1.6.6",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "rimraf": "^6.1.2",
    "rollup": "^4.57.1",
    "rollup-plugin-dts": "^6.3.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
